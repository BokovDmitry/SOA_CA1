@page "/"
@inject ICryptoService CryptoApi

<PageTitle>Crypto-currency</PageTitle>

<h1>Crypto will be here!</h1>

@if (_error is not null)
{
    <p class="text-danger">@_error</p>
}

<h2>GetCryptoIdsAsync(5)</h2>
@if (_ids is null)
{
    <p>No data.</p>
}
else
{
    <ul>
        @foreach (var id in _ids)
        {
            <li>@id</li>
        }
    </ul>
}

<h2>GetCryptoAsync("bitcoin")</h2>
@if (_bitcoin is null)
{
    <p>No data.</p>
}
else
{
    <ul>
        <li>ToString(): @_bitcoin</li>
        <li>Id: @_bitcoin.Id</li>
        <li>Price: @_bitcoin.Price</li>
        <li>Price change 1h: @_bitcoin.PriceChange1h% (@_bitcoin.PriceChange1hAmount)</li>
        <li>Volume: @_bitcoin.Volume</li>
        <li>Market cap: @_bitcoin.MarketCap</li>
        <li>Total supply: @_bitcoin.TotalSupply</li>
    </ul>
}

@code {
    private IReadOnlyList<string>? _ids;
    private SOA_CA1.Crypto? _bitcoin;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _ids = await CryptoApi.GetCryptoIdsAsync(5);
            _bitcoin = await CryptoApi.GetCryptoAsync("bitcoin");
        }
        catch (Exception ex)
        {
            _error = $"{ex.GetType().Name}: {ex.Message}";
        }
    }
}
